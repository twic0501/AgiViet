# Giá trị chỉ dành cho dữ liệu thử; production dùng secret store.
# Stack Oracle agiviet.id.vn dùng riêng oracle/.env.example + tao-cau-hinh.sh.
QR_SECRET=dev-only-qr-secret
WEBHOOK_SECRET=dev-only-webhook-secret
# Tên volume mặc định của db/docker-compose.yml khi chạy độc lập.
AGV_PG_VOLUME=db_agiviet_v2_pgdata
