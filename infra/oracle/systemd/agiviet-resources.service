[Unit]
Description=Kiem tai nguyen va don an toan AgiViet (khong xoa DB/backup)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/agiviet
ExecStart=/bin/bash /opt/agiviet/infra/oracle/canh-tai-nguyen.sh --clean
UMask=0077
TimeoutStartSec=10min
Nice=15
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agiviet-resources
