# MẪU: tao-cau-hinh.sh sinh file thật ngoài repo (không source mẫu này).
OCI_SIZE=12
# 6 = A1 1 OCPU/6 GB; 12 = 2 OCPU/12 GB. Giữ nguyên volume khi resize.
OCI_24GB_CONFIRMED=0
# 0: không build/chạy AI; backend dùng luật sẵn có, không đợi timeout AI.
ENABLE_AI=1
DOMAIN=agiviet.id.vn
# IPv4 public của VM; bắt buộc kiểm DNS trước khi khởi động Caddy.
EXPECTED_IPV4=THAY_BANG_IPV4_PUBLIC
# Để trống nếu chưa cấu hình IPv6 end-to-end; DNS không được có AAAA sót.
EXPECTED_IPV6=
ACME_EMAIL=thay-email@example.com
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
AGV_MOI_TRUONG=production
# Seed là dữ liệu ảo, chỉ được bật khi AGV_MOI_TRUONG=thu.
SEED_DEMO=0
DB_PASSWORD=GENERATE
# Owner chỉ dùng cho migrate/provision/dump/restore. Runtime: gateway NOINHERIT.
AGV_GATEWAY_PASSWORD=GENERATE
# Để trống: chung.sh chọn 4 (6 GB), 6 (12/24 GB). 6 GB không cho pool >4.
AGV_PG_POOL_MAX=
AGV_SESSION_SECRET=GENERATE
AGV_OTP_PEPPER=GENERATE
AGV_WEBHOOK_SECRET=GENERATE
AGV_FALLBACK_SECRET=GENERATE
AGV_AI_API_KEY=GENERATE
AGV_QR_PRIVATE_PEM_B64=GENERATE_ED25519
AGV_PDF_PRIVATE_PEM_B64=GENERATE_ED25519
AGV_QR_KID=qr-oci-1
AGV_PDF_KID=pdf-oci-1
# caddy hash-password tương tác; giữ dấu nháy đơn bao quanh hash bcrypt.
CADDY_PASSWORD_HASH='THAY_BANG_BCRYPT'
# Tên mới: không nhận nhầm volume agiviet_bench của stack cũ.
AGV_PG_VOLUME=agiviet_oracle_v2_pgdata
ORACLE_ARTIFACTS_VOLUME=agiviet_oracle_v2_artifacts
ORACLE_AI_VOLUME=agiviet_oracle_v2_ai_audit
DEPLOY_BRANCH=main
STATE_DIR=/var/lib/agiviet
BACKUP_DIR=/var/lib/agiviet/backups
REMOTE_BACKUP=oci:ten-bucket/agiviet-oracle-v2
RCLONE_CONFIG=/etc/agiviet/rclone.conf
BACKUP_AGE_RECIPIENT=THAY_BANG_AGE_PUBLIC_RECIPIENT
KEEP_BACKUPS=7
MAX_REMOTE_BYTES=8589934592
# Ngưỡng cảnh báo host/volume; GiB ở đây = 1024^3 byte.
RESOURCE_DISK_WARN_PCT=80
RESOURCE_RAM_WARN_PCT=85
RESOURCE_DB_WARN_GIB=20
RESOURCE_UPLOAD_WARN_GIB=10
RESOURCE_AI_WARN_GIB=1
RESOURCE_CACHE_WARN_GIB=5
RESOURCE_TEMP_WARN_GIB=1
# Chỉ dọn file *.tmp/*.part >48h trong STATE_DIR/tmp (không phải uploads/backup).
# BACKUP_AGE_IDENTITY chỉ đặt ở máy phục hồi, ngoài repo.
