D["can_chot"] = CAN_CHOT_THEM + D["can_chot"]
D["ten_nhom"]["ra_soat"] = "Bổ sung rà soát độc lập (27/10)"
D["nguon_chinh"] += " Bản 2 sửa theo góp ý người sáng lập 27/10 (chấm tím): hệ thống soạn hợp đồng từ nghĩa vụ hai bên, ngân hàng mở tài khoản giữ cọc, chọn dịch vụ khi cọc, trả phần còn lại sau nghiệm thu và đối soát, nhân viên đảm bảo từng khâu."
# Tình huống "trả khi nhận" nay là luồng chính HĐ-0018; trỏ đối chiếu về đó.
def doi(ds): return [("hd0018" if x == "tra-khi-nhan" else x) for x in ds]
D["doi_chieu"]["a3"] = [[q, doi(ds)] for q, ds in D["doi_chieu"]["a3"]]
D["doi_chieu"]["c"] = [[q, doi(ds)] for q, ds in D["doi_chieu"]["c"]]
D["doi_chieu"]["c"][5][1] += ["tien-mat-tai-cho", "chua-tra-tien-mat", "ung-tien"]
D["doi_chieu"]["c"][4][1] = ["hd0018", "n1-tu-choi", "n11-13-de-nghi"]
ids = {t["id"] for t in T}
for nhom in ("a3", "c"):
    for _, ds in D["doi_chieu"][nhom]:
        assert all(x in ids for x in ds), [x for x in ds if x not in ids]
p = os.path.join(os.path.dirname(os.path.abspath(__file__)), "quy-trinh.json")
json.dump(D, open(p, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
print("ok", len(T), "tình huống,", sum(len(t["buoc"]) for t in T), "bước")
