   B("app", "Đóng đơn, gợi ý hộ khác", o_dau="he_thong", luong=[("tin", "mua", "Cô Hai · 3 tấn")], tt="Đóng", nguon=["E1"])], ["D2 nhánh 1"], vai=["mua", "app", "ban"])
