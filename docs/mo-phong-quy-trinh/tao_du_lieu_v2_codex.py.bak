import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from tinh_huong import xay, CAN_CHOT_THEM
T = xay(B, TH, TRANG_THAI)

# Rà soát độc lập 27/10: chỉ bổ sung storyboard có căn cứ; giữ nguyên 28
# tình huống đầu để các sai lệch trong ra-soat-codex.md còn đối chiếu được.
# Không dùng Motion v2 làm nguồn chốt luật. Không tạo engine giao dịch.
def bo_sung_ra_soat():
    def them(id, ten, mo, buoc, nguon, gia_tri=None, loai="goc", ghi=""):
        vd = {"gia_tri": gia_tri, "ghi": ghi} if gia_tri is not None else {}
        T.append(TH(id, ten, "ra_soat", mo, buoc, nguon=nguon, vi_du=vd,
                    vai=list(dict.fromkeys([b["vai"] for b in buoc] +
                        [l["den"] for b in buoc for l in b["luong"]])), loai=loai))

    them("rs-tra-thieu-bo-sung", "Rà soát · nhận 20 triệu, bổ sung rồi mới bốc",
      "Biến thể trả trước khi bốc. 20 triệu là khoản đã xác nhận, 12,2 triệu là khoản còn thiếu; chưa đủ thì chưa giao.", [
        B("nh", "Đã xác nhận cọc 13.800.000", o_dau="ngan_hang", so={"coc_giu": 13800000}, tt="Đã cọc, chờ giao", nguon=["C13 chặng 2"]),
        B("mua", "Ghi đã trả 20.000.000", o_dau="ngoai_app", luong=[("tien", "ban", "20.000.000 đ")], nguon=["Prompt mua V2 §8.3"]),
        B("ban", "Nhận một phần: 20.000.000", so={"tra_thang": 20000000, "con_no": "Bên mua còn phải trả trước khi bốc 12.200.000 đ"}, dieu_kien="Chưa đủ 32.200.000: chưa cho bốc; cọc vẫn giữ", nguon=["Brief bán §3.5", "Prompt mua V2 §8.3"]),
        B("mua", "Trả nốt 12.200.000", o_dau="ngoai_app", luong=[("tien", "ban", "12.200.000 đ")], nguon=["Prompt mua V2 §8.3"]),
        B("ban", "Xác nhận tổng đã nhận 32.200.000", so={"tra_thang": 32200000, "con_no": ""}, dieu_kien="Tự kiểm tài khoản; cọc chưa chuyển", nguon=["C6"]),
        B("app", "Chỉ cho bốc khi đủ mọi dòng Sẵn sàng giao", o_dau="he_thong", tt="Đang giao", dieu_kien="Tiền, hàng, người nhận, xe, hồ sơ, mốc rủi ro đều đủ", chi_tiet="Dừng ở mốc được giao; chưa nghiệm thu hay quyết toán.", nguon=["C13 chặng 3–4"])],
      ["C6", "C13", "Prompt mua V2 §8.3"], 46000000)

    them("rs-lech-tien", "Rà soát · báo trả 32,2 triệu, chỉ thấy 20 triệu",
      "Lệch cần đối soát khác với vi phạm đã xác minh. Không lấy ảnh ủy nhiệm chi hoặc im lặng làm tiền đã nhận.", [
        B("nh", "Cọc đang giữ 13.800.000", o_dau="ngan_hang", so={"coc_giu": 13800000}, nguon=["C6"]),
        B("mua", "Báo đã chuyển 32.200.000, gửi chứng từ", luong=[("giay", "app", "ủy nhiệm chi")], nguon=["Prompt mua V2 §8.4"]),
        B("ban", "Chỉ xác nhận đã thấy 20.000.000", so={"tra_thang": 20000000}, tt="Lệch, đang đối soát", dieu_kien="Chưa bốc, chưa phạt, chưa chuyển cọc", nguon=["Đặc tả mua V1 §1 L5", "Prompt mua V2 §8.4"]),
        B("nv", "Đối chiếu chứng từ với sao kê, mời bổ sung", o_dau="nhan_vien", han="48 giờ khi bên mua báo trả mà chưa xác nhận", chi_tiet="Chỉ chốt số có bằng chứng; chưa có kết quả thì giữ trạng thái đối soát, không tự kết luận đã trả hoặc vi phạm.", nguon=["C6", "C9"])],
      ["C6", "C9", "Prompt mua V2 §8.4"], 46000000)

    them("rs-phan-doi-mot-dong", "Rà soát · chỉ phản đối dòng hạ cấp",
      "Giữ các dòng đã thống nhất; dòng hạ cấp 120 kg đi cân lại rồi kiểm định nếu vẫn bất đồng.", [
        B("mua", "Gửi 1.850 đạt, 120 hạ cấp, 30 trả lại", luong=[("tin", "ban", "bảng nghiệm thu từng dòng")], nguon=["Prompt mua V2 §8.6"]),
        B("ban", "Có phần không đúng: chọn dòng 120 kg", chi_tiet="Đạt và trả lại vẫn chốt; chưa coi tổng tiền là nghiệm thu cuối.", tt="Đã chốt phần không tranh chấp · đang kiểm định phần còn lại", nguon=["Brief bán G7", "C13 chặng 8"]),
        B("mua", "Cân lại riêng dòng bất đồng", han="24 giờ", luong=[("giay", "ban", "ảnh cân lại")], nguon=["C9"]),
        B("kd", "Vẫn bất đồng: kiểm định, bên sai chịu phí", o_dau="ngoai_app", han="48 giờ", chi_tiet="Cọc giữ tới kết quả; chưa có kết luận thì chưa quyết toán. Chốt lại giá trị nghiệm thu từ kết quả, không tự giải ngân phần tiền đang tranh chấp.", nguon=["C9", "Prompt mua V2 §8.6"])],
      ["C9", "C13", "Prompt mua V2 §8.6"])

    them("rs-can-lech", "Rà soát · cân 1.960 kg và thử ngoài khoảng",
      "Hai phép thử của cùng hợp đồng 2.000 kg, khoảng ±5% đã ký. Ba phần phải cộng đúng lượng cân thực tế.", [
        B("mua", "Cân 1.960 kg: trong khoảng 1.900–2.100 kg", dieu_kien="Khoảng ±5% có trong hợp đồng; không phải luật chung mọi mặt hàng", nguon=["Đặc tả mua H5", "Prompt mua V2 §8.7"]),
        B("app", "Trong khoảng: giữ luồng thuận", o_dau="he_thong", chi_tiet="Đạt + hạ cấp + trả lại = 1.960 kg; chưa có phân bổ thì chưa tính giá trị nghiệm thu.", nguon=["C5", "Prompt mua V2 §8.7"]),
        B("mua", "Phép thử khác: cân 1.850 kg", chi_tiet="Đây là phép thử thay thế 1.960 kg, không phải một lần giao thêm.", nguon=["Prompt mua V2 §8.7"]),
        B("app", "Ngoài khoảng: mở xử lý thiếu lượng", o_dau="he_thong", tt="Chờ xử lý thiếu lượng", dieu_kien="Xác định nguyên nhân, phần thiếu và nghĩa vụ giao bù; chưa Hoàn tất", nguon=["C9", "Prompt mua V2 §8.7"])],
      ["C5", "C9", "Prompt mua V2 §8.7"])

    them("rs-thieu-luong", "Rà soát · ước sai, không báo, còn phải giao bù",
      "Phân biệt với bất khả kháng ở n4-mat-mua. Mỗi nguyên nhân có cách xử lý riêng; không gộp thành mất mùa.", [
        B("ban", "Ước sai: báo giảm lượng trước ít nhất 3 ngày", luong=[("tin", "mua", "đề nghị giảm lượng")], chi_tiet="Bên mua đồng ý hoặc tìm bù qua đơn nhóm; phạt 10% cọc phần thiếu, giảm uy tín theo C9. Cách trích khoản phạt cần đối chiếu quy tắc cọc, chưa tự tính thêm.", nguon=["C9 thiếu lượng"]),
        B("app", "Nếu không báo, giao thiếu tại chỗ: tách phần thiếu", o_dau="he_thong", chi_tiet="C6 và D2 nhánh 4: cọc phần thiếu hoàn bên mua; C9 gọi là người bán mất cọc phần thiếu. Hai cách diễn đạt cùng hướng, không phải hai khoản phạt. Không suy ra cọc đủ bù toàn bộ hàng.", nguon=["C6", "C9", "D2 nhánh 4"]),
        B("ban", "Nếu hai bên chọn giao bù: ghi lượng, ngày, tiền", luong=[("tin", "app", "nghĩa vụ giao sau")], dieu_kien="Hai bên đồng ý, có lịch và tiền riêng cho phần giao bù", nguon=["C13 chặng 8", "CSV luồng 8: Giao đợt sau"]),
        B("app", "Còn giao bù thì chưa Hoàn tất", o_dau="he_thong", tt="Đã giao một phần · còn nghĩa vụ giao bù", nguon=["C13 chặng 8"])],
      ["C6", "C9", "C13 chặng 8"])

    them("rs-huy-ben-mua", "Rà soát · bên mua xin hủy sau cọc",
      "Nhánh 10 còn thiếu chiều khởi xướng. Chưa trả thẳng, chưa giao; đề nghị im lặng không thành hủy.", [
        B("nh", "Đang giữ cọc 13.800.000", o_dau="ngan_hang", so={"coc_giu": 13800000}, nguon=["D2b nhánh 10"]),
        B("mua", "Xin hủy, xem riêng hàng, cọc, phí, trả thẳng", luong=[("tin", "ban", "yêu cầu hủy")], han="24 giờ", chi_tiet="Hàng về lô nếu đồng ý; cọc về người bán. Phí 138.000 không hoàn là đề xuất chờ chốt, không phải luật đã duyệt.", nguon=["D2b nhánh 10", "C9 hoàn phí"], loai="mau_thuan"),
        B("app", "Không đồng ý hoặc im lặng: đơn tiếp tục", o_dau="he_thong", dieu_kien="Không tự chuyển cọc vì hết hạn trả lời", nguon=["D2b nhánh 10"]),
        B("ban", "Nhánh đồng ý: chấp thuận hủy", luong=[("tin", "app", "đồng ý hủy")], chi_tiet="Bước này là nhánh thay thế bước không đồng ý, không nối hai quyết định thành một.", nguon=["D2b nhánh 10"]),
        B("nh", "Xác nhận cọc 13.800.000 đã về người bán", o_dau="ngan_hang", luong=[("tien", "ban", "13.800.000 đ")], so={"coc_giu": 0, "coc_chi_ban": 13800000}, tt="Đóng · hủy có thỏa thuận", nguon=["C6", "C13 chặng 7"])],
      ["D2b nhánh 10", "Prompt mua V2 §8.8"], 46000000, "mau_thuan", "Cọc ở đây xử lý do hủy, không áp đẳng thức giá trị nghiệm thu cho tiền bồi hoàn cam kết.")

    them("rs-de-nghi-dang-cho", "Rà soát · đề nghị chưa trả lời thì chưa ký, chưa cọc",
      "Bên nào cũng có thể đề nghị. Minh họa người bán đổi 28/10 → 29/10 trước ký; không âm thầm sửa bản đã đồng ý.", [
