{
  // App bán: TypeScript (mỗi màn một .html + .ts cùng tên, module dùng chung *.ts); Vite dịch khi chạy dev và khi build.
  // Script cổ điển chạy trước khi vẽ trang (chuyen-trang.js) và thư viện hiệu ứng nạp theo đường dẫn (hieu-ung-*.js) giữ là JS.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": { "/shared/*": ["../shared/*"], "/assets/*": ["../assets/*"] }
  },
  "include": ["kieu-toan-cuc.d.ts", "*.ts"]
}
