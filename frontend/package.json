{
  "name": "agiviet-v2-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/flow.mjs",
    "types": "python3 scripts/generate-types.py",
    "test:branches": "node tests/branches.mjs",
    "test:round2": "node tests/round2.mjs",
    "test:public": "node tests/public-login.mjs",
    "test:admin": "node tests/admin.mjs",
    "test:login": "node tests/login-resilience.mjs",
    "test:cases": "node tests/admin-cases.mjs",
    "test:opponent": "node tests/opponent-flow.mjs",
    "build": "vite build",
    "start:dist": "AGV_STATIC=dist node server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p mua-ts/tsconfig.json && tsc -p thiet-ke/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
